default_platform(:ios)

platform :ios do
  private_lane :load_asc_api_key do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID", "3U5GRBXLAR")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID", "47e0206d-5840-4dbb-b8d7-80f19523322d")
    key_content_b64 = ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64", "")
    default_key_path = File.expand_path("../../AuthKey_3U5GRBXLAR.p8", __dir__)
    key_path = ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH", File.exist?(default_key_path) ? default_key_path : "")

    if key_id.empty? || issuer_id.empty?
      UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ID or APP_STORE_CONNECT_ISSUER_ID environment variables.")
    end

    if !key_content_b64.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content_b64,
        is_key_content_base64: true,
        in_house: false
      )
    elsif !key_path.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_path,
        in_house: false
      )
    else
      UI.user_error!("Provide either APP_STORE_CONNECT_API_KEY_BASE64 or APP_STORE_CONNECT_API_KEY_PATH.")
    end
  end

  desc "Run pre-release quality, tests, metadata & screenshot dimension checks"
  lane :preflight do |options|
    track_flag = options[:production] ? "--track=production" : ""
    Dir.chdir("../..") do
      sh("dart run scripts/ci_preflight_check.dart #{track_flag}")
      sh("flutter analyze")
      sh("flutter test")
    end
  end

  desc "Build signed iOS Archive & IPA for App Store / TestFlight"
  lane :build_ipa do
    Dir.chdir("../..") do
      sh("flutter build ipa --release")
    end
  end

  desc "Upload 6-language store metadata and localized screenshots to App Store Connect"
  lane :upload_metadata_and_screenshots do
    api_key = load_asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.goalverse.footballsos"),
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload signed IPA to TestFlight via App Store Connect API"
  lane :testflight_release do
    preflight(production: false)
    api_key = load_asc_api_key
    build_ipa

    ipa_files = Dir.glob(File.expand_path("../../build/ios/ipa/*.ipa", __dir__))
    UI.user_error!("No .ipa file found in build/ios/ipa/") if ipa_files.empty?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_files.first,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload IPA, 6-Language Metadata, and Screenshots for App Store Review (Requires CONFIRM_PRODUCTION_RELEASE=true)"
  lane :production do
    unless ENV["CONFIRM_PRODUCTION_RELEASE"] == "true"
      UI.user_error!("App Store production submission blocked: Set CONFIRM_PRODUCTION_RELEASE=true after verifying TestFlight build.")
    end

    preflight(production: true)
    api_key = load_asc_api_key
    build_ipa

    ipa_files = Dir.glob(File.expand_path("../../build/ios/ipa/*.ipa", __dir__))
    UI.user_error!("No .ipa file found in build/ios/ipa/") if ipa_files.empty?

    deliver(
      api_key: api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.goalverse.footballsos"),
      ipa: ipa_files.first,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: false,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true",
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

